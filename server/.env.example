# Copy to server/.env for local development (never commit .env).
# On Render, set these under Environment instead.

# Supabase → Connect → "Session pooler" connection string (port 5432, IPv4)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Long random string used to sign login tokens
JWT_SECRET=replace-with-a-long-random-string

# Allowed frontend origin(s), comma-separated. localhost:5173 is always allowed.
CLIENT_URL=https://your-app.vercel.app

# Optional
# APP_TIMEZONE=Asia/Bangkok   # what "today" means for schedules and plans
# PG_POOL_MAX=5               # max DB connections from this server
# PORT=3001                   # Render sets this automatically
